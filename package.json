{
  "name": "dsh-llm-hub",
  "version": "0.2.1",
  "description": "DSH 的 LLM 配置补强：deepseek-official 的模型发现与余额卡 + llm-pi-ai 各 provider 的网关探测、目录旁路，以及 MiniMax/智谱/Moonshot/StepFun 开放余额与配额接口的适配卡。零运行时依赖，不改动 DSH 安装。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "deploy": "rsync -av --delete lib/ ~/.dsh/profiles/web/node_modules/dsh-llm-hub/lib/ && rsync -av package.json cordis.patch.yml README.md README.en.md LICENSE ~/.dsh/profiles/web/node_modules/dsh-llm-hub/",
    "preview": "npm run deploy && open http://127.0.0.1:3080",
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "model-discovery",
    "balance",
    "llm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webkubor/dsh-llm-hub.git"
  },
  "bugs": {
    "url": "https://github.com/webkubor/dsh-llm-hub/issues"
  },
  "homepage": "https://github.com/webkubor/dsh-llm-hub#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.en.md",
    "README.md",
    "cordis.patch.yml",
    "lib"
  ]
}
